#!/bin/sh
set -e
case "$1" in
configure)
    if ! getent passwd candled >/dev/null; then
        adduser --system --group --home /var/lib/candled --no-create-home --gecos "candled, the candle server" candled
    fi
    mkdir -p /var/lib/candled/candles
    chown candled:candled /var/lib/candled /var/lib/candled/candles
    mkdir -p /etc/candled
    chown root:candled /etc/candled; chmod 750 /etc/candled
    if [ ! -e /etc/candled/server.key ]; then
        candled --gen-cert --certificate /etc/candled/server.crt --key /etc/candled/server.key >/dev/null
        chown root:candled /etc/candled/server.key /etc/candled/server.crt
        chmod 640 /etc/candled/server.key; chmod 644 /etc/candled/server.crt
    fi
    if [ ! -e /etc/candled/authorized-clients ]; then
        : > /etc/candled/authorized-clients
        chown root:candled /etc/candled/authorized-clients; chmod 640 /etc/candled/authorized-clients
    fi
    ;;
esac

#DEBHELPER#
