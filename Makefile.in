# Makefile for wincan; written by ./configure from Makefile.in
PACKAGE   = wincan
VERSION   = @VERSION@
prefix    = @prefix@
bindir    = $(prefix)/bin
sbindir   = $(prefix)/sbin
mandir    = $(prefix)/share/man
CC        = @CC@
WINCC     = @WINCC@
HASWIN    = @HASWIN@
CFLAGS   ?= -O2
WARN      = -std=gnu11 -Wall -Wextra -DPACKAGE_VERSION='"$(VERSION)"'
DISTFILES = AUTHORS COPYING ChangeLog INSTALL NEWS README VERSION configure Makefile.in \
            src/agg.c src/agg.h src/heat.c src/heat.h src/candled.c src/wincan.c tests/test_agg.c tests/test_heat.c \
            man/candled.8 man/wincan.1 man/wincan.5 contrib/candled.service

TARGETS = candled
ifeq ($(HASWIN),yes)
TARGETS += wincan.exe
endif

all: $(TARGETS)

candled: src/candled.c src/agg.c src/agg.h src/heat.c src/heat.h
	$(CC) $(CFLAGS) $(WARN) -o $@ src/candled.c src/agg.c src/heat.c -lsqlite3 -lcurl -lpthread -lm

wincan.exe: src/wincan.c
	$(WINCC) $(CFLAGS) $(WARN) -mwindows -o $@ src/wincan.c -lgdi32 -lwinhttp -lshell32 -luser32 -lws2_32

win: wincan.exe

test_agg: tests/test_agg.c src/agg.c src/agg.h
	$(CC) $(CFLAGS) $(WARN) -o $@ tests/test_agg.c src/agg.c -lm -lsqlite3 -lpthread

test_heat: tests/test_heat.c src/heat.c src/heat.h
	$(CC) $(CFLAGS) $(WARN) -o $@ tests/test_heat.c src/heat.c -lm

check: test_agg test_heat
	./test_agg
	./test_heat

install: all
	install -d $(DESTDIR)$(sbindir) $(DESTDIR)$(bindir) $(DESTDIR)$(mandir)/man8 $(DESTDIR)$(mandir)/man1 $(DESTDIR)$(mandir)/man5
	install -m 755 candled $(DESTDIR)$(sbindir)/candled
	[ ! -f wincan.exe ] || install -m 755 wincan.exe $(DESTDIR)$(bindir)/wincan.exe
	install -m 644 man/candled.8 $(DESTDIR)$(mandir)/man8/candled.8
	install -m 644 man/wincan.1 $(DESTDIR)$(mandir)/man1/wincan.1
	install -m 644 man/wincan.5 $(DESTDIR)$(mandir)/man5/wincan.5

uninstall:
	rm -f $(DESTDIR)$(sbindir)/candled $(DESTDIR)$(bindir)/wincan.exe \
	      $(DESTDIR)$(mandir)/man8/candled.8 $(DESTDIR)$(mandir)/man1/wincan.1 $(DESTDIR)$(mandir)/man5/wincan.5

# copy the sources to the machine with the candle files and build the server there:  make deploy HOST=name [DIR=wincan]
DIR = wincan
deploy:
	@[ -n "$(HOST)" ] || { echo "usage: make deploy HOST=name"; exit 2; }
	tar cf - src configure Makefile.in VERSION | ssh -T $(HOST) 'mkdir -p $(DIR) && cd $(DIR) && tar xf - && ./configure --prefix=$$HOME/.local >/dev/null && make candled'

dist: $(DISTFILES)
	rm -rf $(PACKAGE)-$(VERSION)
	mkdir $(PACKAGE)-$(VERSION)
	tar cf - $(DISTFILES) | (cd $(PACKAGE)-$(VERSION) && tar xf -)
	tar czf $(PACKAGE)-$(VERSION).tar.gz $(PACKAGE)-$(VERSION)
	rm -rf $(PACKAGE)-$(VERSION)

clean:
	rm -f candled wincan.exe test_agg test_heat

distclean: clean
	rm -f Makefile $(PACKAGE)-*.tar.gz

.PHONY: all win check install uninstall deploy dist clean distclean
