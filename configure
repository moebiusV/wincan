#! /bin/sh
# configure -- finds the compilers and writes Makefile from Makefile.in
prefix=/usr/local
CC=${CC:-cc}
WINCC=${WINCC:-x86_64-w64-mingw32-gcc}
for a in "$@"; do
    case $a in
        --prefix=*) prefix=${a#--prefix=} ;;
        CC=*) CC=${a#CC=} ;;
        WINCC=*) WINCC=${a#WINCC=} ;;
        --help|-h)
            cat <<USAGE
Usage: ./configure [--prefix=DIR] [CC=cc] [WINCC=x86_64-w64-mingw32-gcc]

  CC     the C compiler for candled (the server, which runs on the machine with the candle files)
  WINCC  the MinGW-w64 compiler for wincan.exe (the Windows window); without it only the server is built
USAGE
            exit 0 ;;
        *) echo "configure: unknown option $a" >&2; exit 2 ;;
    esac
done
version=$(sed -n 's/^AC_INIT.*\[\([0-9.]*\)\].*/\1/p' configure.ac 2>/dev/null)
[ -n "$version" ] || version=$(cat VERSION)
command -v "$CC" >/dev/null 2>&1 || { echo "configure: no C compiler ($CC)" >&2; exit 1; }
echo "checking for $CC... yes"
if command -v "$WINCC" >/dev/null 2>&1; then echo "checking for $WINCC... yes (wincan.exe will be built)"; haswin=yes
else echo "checking for $WINCC... no (only candled will be built)"; haswin=no; fi
sed -e "s|@prefix@|$prefix|g" -e "s|@CC@|$CC|g" -e "s|@WINCC@|$WINCC|g" -e "s|@HASWIN@|$haswin|g" -e "s|@VERSION@|$version|g" Makefile.in > Makefile
echo "configure: wrote Makefile (version $version, prefix $prefix)"
