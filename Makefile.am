# Makefile.am -- wincan: candled (the candle server) and wincan.exe (the candle window for Windows).

ACLOCAL_AMFLAGS = -I m4

AM_CFLAGS = -Wall -Wextra
AM_CPPFLAGS = -I$(top_srcdir)/src \
              -DSYSCONFDIR='"$(sysconfdir)"' -DSTATEDIR='"$(localstatedir)/lib/candled"'

# ---------------------------------------------------------------- candled
sbin_PROGRAMS = candled

candled_SOURCES = src/candled.c src/agg.c src/agg.h src/heat.c src/heat.h src/tls.c src/tls.h
candled_LDADD = libcandledconf.a

# The parser of candled.conf was generated by hbnf from grammars/candled.hbnf (see HACKING); it is built apart,
# without the warning that its generated structure initializers give.
noinst_LIBRARIES = libcandledconf.a
libcandledconf_a_SOURCES = src/candled_conf.c src/candled_conf.h src/hbnf_conf.c src/hbnf_conf.h
libcandledconf_a_CFLAGS = $(AM_CFLAGS) -Wno-missing-field-initializers

# ---------------------------------------------------------------- tests
check_PROGRAMS = test_agg test_heat test_go test_conf
test_agg_SOURCES = tests/test_agg.c src/agg.c src/agg.h
test_heat_SOURCES = tests/test_heat.c src/heat.c src/heat.h
test_go_SOURCES = tests/test_go.c src/gomatch.h
test_conf_SOURCES = tests/test_conf.c
test_conf_LDADD = libcandledconf.a

TESTS = test_agg test_heat test_go test_conf tests/test_tls.sh tests/test_formats.sh tests/no-private.sh
AM_TESTS_ENVIRONMENT = srcdir='$(srcdir)'; export srcdir; CANDLED='$(abs_builddir)/candled'; export CANDLED;
dist_check_SCRIPTS = tests/test_tls.sh tests/test_formats.sh tests/no-private.sh

# ---------------------------------------------------------------- wincan.exe, the window (a Windows program, built with MinGW-w64)
WINCFLAGS = -O2 -std=gnu11 -Wall -Wextra
WINLIBS = -lgdi32 -lwinhttp -lshell32 -luser32 -lws2_32 -lcrypt32 -lbcrypt -lncrypt

if BUILD_WINCAN
wincan.exe: $(srcdir)/src/wincan.c $(srcdir)/src/gomatch.h Makefile
	$(AM_V_CCLD)$(WINCC) $(WINCFLAGS) -DPACKAGE_VERSION='"$(PACKAGE_VERSION)"' -mwindows -o $@ $(srcdir)/src/wincan.c $(WINLIBS)

all-local: wincan.exe
windows_DATA = wincan.exe
CLEANFILES = wincan.exe
endif
windowsdir = $(pkgdatadir)/windows
dist_windows_DATA = windows/install.ps1 windows/uninstall.ps1 windows/install.cmd windows/README.txt

# SHA256SUMS next to the files, which install.ps1 checks before it copies them
install-data-hook:
	@if test -f '$(DESTDIR)$(windowsdir)/wincan.exe'; then \
	  cd '$(DESTDIR)$(windowsdir)' && sha256sum wincan.exe install.ps1 uninstall.ps1 install.cmd > SHA256SUMS; \
	fi
	$(MKDIR_P) '$(DESTDIR)$(sysconfdir)/candled'
	@if test ! -f '$(DESTDIR)$(sysconfdir)/candled.conf'; then \
	  echo "$(INSTALL_DATA) contrib/candled.conf.sample $(DESTDIR)$(sysconfdir)/candled.conf"; \
	  $(INSTALL_DATA) '$(srcdir)/contrib/candled.conf.sample' '$(DESTDIR)$(sysconfdir)/candled.conf'; \
	fi

# a configuration the administrator has changed stays; an unchanged one goes with the program
uninstall-hook:
	rm -f '$(DESTDIR)$(windowsdir)/SHA256SUMS'
	@if cmp -s '$(srcdir)/contrib/candled.conf.sample' '$(DESTDIR)$(sysconfdir)/candled.conf'; then \
	  rm -f '$(DESTDIR)$(sysconfdir)/candled.conf'; \
	fi
	-rmdir '$(DESTDIR)$(sysconfdir)/candled' 2>/dev/null
	-rmdir '$(DESTDIR)$(windowsdir)' 2>/dev/null
	-rmdir '$(DESTDIR)$(pkgdatadir)' 2>/dev/null

installcheck-local:
	@v=`'$(DESTDIR)$(sbindir)/candled' --version | sed -n '1s/.* //p'`; \
	test "$$v" = '$(VERSION)' || { echo "installcheck: candled reports version $$v, not $(VERSION)"; exit 1; }
	'$(DESTDIR)$(sbindir)/candled' --help >/dev/null

# ---------------------------------------------------------------- service files, examples, documents
examplesdir = $(docdir)/examples
dist_examples_DATA = contrib/candled.conf.sample contrib/candle-writer.py
nodist_examples_DATA = contrib/candled.service contrib/candled.openrc

if HAVE_SYSTEMD
systemdsystemunit_DATA = contrib/candled.service
endif

dist_man_MANS = man/candled.8 man/candled.conf.5 man/candled-data.5 man/candle-protocol.7 man/wincan.1 man/wincan.5
dist_doc_DATA = README NEWS AUTHORS THANKS

EXTRA_DIST = ChangeLog HACKING README.md src/wincan.c tools/mkpages.sh \
             contrib/candled.service.in contrib/candled.openrc.in \
             grammars/candled.hbnf tools/regen-conf.sh \
             tests/conf docs linux debian bootstrap \
             contrib/wincan.spec contrib/APKBUILD

# ---------------------------------------------------------------- for the maintainer
# regenerate the parser of candled.conf from its grammar (needs hbnf, which the build does not):
#     make regen-conf HBNF=/path/to/hbnf HBNF_TEMPLATES=/path/to/hbnf/templates
regen-conf:
	HBNF='$(HBNF)' HBNF_TEMPLATES='$(HBNF_TEMPLATES)' '$(srcdir)/tools/regen-conf.sh'

# copy the sources to the machine with the candle files and build the server there:  make deploy HOST=name [DIR=wincan]
DIR = wincan
deploy: dist
	@test -n '$(HOST)' || { echo "usage: make deploy HOST=name [DIR=wincan]"; exit 2; }
	cat '$(PACKAGE)-$(VERSION).tar.gz' | ssh -T '$(HOST)' 'mkdir -p $(DIR) && cd $(DIR) && tar xzf - --strip-components=1 && ./configure --prefix=$$HOME/.local >/dev/null && make candled'

.PHONY: regen-conf deploy
